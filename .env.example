# The Next.js frontend proxies /api and /media to this standalone backend.
BACKEND_URL=http://127.0.0.1:4000

# Backend listener and persistent media/job storage.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=4000
BACKEND_DATA_DIR=./data
BACKEND_MAX_CLI_CONCURRENCY=2
BACKEND_MAX_RENDER_CONCURRENCY=1

# Higgsfield generation runs through the authenticated CLI on the backend.
# Install the CLI and run `higgsfield auth login`; do not paste OAuth tokens here.
HIGGSFIELD_CLI_PATH=higgsfield
HIGGSFIELD_IMAGE_MODEL=gpt_image_2
HIGGSFIELD_VIDEO_MODEL=seedance_2_0
HIGGSFIELD_MOCK_MODE=false

# Optional local/worker paths for final MP4 rendering.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
