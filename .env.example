# The Next.js frontend proxies /api and /media to this standalone backend.
BACKEND_URL=http://127.0.0.1:4000

# Backend listener and persistent media/job storage.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=4000
BACKEND_DATA_DIR=./data
BACKEND_CORS_ORIGIN=
BACKEND_MAX_CLI_CONCURRENCY=2
BACKEND_MAX_RENDER_CONCURRENCY=1

# Required for one-time creation of the first administrator. Generate a unique
# value with `openssl rand -base64 32`; do not commit the populated .env.local.
BACKEND_BOOTSTRAP_TOKEN=

# false is only for loopback HTTP development. Use true for every HTTPS deployment.
BACKEND_AUTH_COOKIE_SECURE=false
BACKEND_AUTH_SESSION_TTL_MS=604800000
BACKEND_LOGIN_ATTEMPT_LIMIT=5
BACKEND_LOGIN_WINDOW_MS=900000

# Docker Compose publishes local HTTP on loopback by default. Keep this on
# loopback behind a host HTTPS reverse proxy; never use 0.0.0.0 for remote HTTP.
STUDIO_BIND_ADDRESS=127.0.0.1
STUDIO_HTTP_PORT=80

# Higgsfield generation runs through the authenticated CLI on the backend.
# Install the CLI and run `higgsfield auth login`; do not paste OAuth tokens here.
HIGGSFIELD_CLI_PATH=higgsfield
HIGGSFIELD_IMAGE_MODEL=gpt_image_2
HIGGSFIELD_VIDEO_MODEL=seedance_2_0
HIGGSFIELD_MOCK_MODE=false

# Optional local/worker paths for final MP4 rendering.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
