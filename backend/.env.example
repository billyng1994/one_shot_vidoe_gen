BACKEND_PORT=4000
BACKEND_HOST=127.0.0.1
BACKEND_DATA_DIR=./data
BACKEND_CORS_ORIGIN=http://localhost:3000
# Generate with `openssl rand -base64 32`. A populated value is required before
# creating the first administrator and is mandatory when NODE_ENV=production.
BACKEND_BOOTSTRAP_TOKEN=
# false is suitable only when the browser uses loopback HTTP.
BACKEND_AUTH_COOKIE_SECURE=false
BACKEND_AUTH_SESSION_TTL_MS=604800000
BACKEND_LOGIN_ATTEMPT_LIMIT=5
BACKEND_LOGIN_WINDOW_MS=900000
HIGGSFIELD_MOCK_MODE=true
# These optional CLI settings apply to native backend development. Docker uses
# its bundled CLI and the private `higgsfield-auth` named volume; authenticate
# inside the backend container as documented in README.md.
# HIGGSFIELD_CLI_PATH=higgsfield
# HIGGSFIELD_IMAGE_MODEL=gpt_image_2
# HIGGSFIELD_VIDEO_MODEL=seedance_2_0
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# BACKEND_MAX_CLI_CONCURRENCY=2
# BACKEND_MAX_RENDER_CONCURRENCY=1
# BACKEND_MAX_IMAGE_BYTES=31457280
# BACKEND_MAX_VIDEO_BYTES=262144000
# BACKEND_MAX_MUSIC_BYTES=41943040
# BACKEND_POLL_INITIAL_DELAY_MS=2000
# BACKEND_POLL_MAX_DELAY_MS=10000
# BACKEND_POLL_WINDOW_MS=720000
